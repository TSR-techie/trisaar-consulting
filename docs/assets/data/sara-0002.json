    {
      "id": "solution",
      "component": "solution",
      "variant": "solution-decision-path",
      "visible": true,

      "data": {
        "eyebrow": "Solution",
        "title": "From manual spreadsheets to an automated intelligence engine.",
        "intro": "We harmonized disparate underwriting criteria into a centralized risk framework, then built automated extraction and risk-scoring modules so underwriters could focus on deal structuring.",

        "hub": {
          "icon": "puzzle",
          "label": "Our Approach",
          "body": "A repeatable framework that turns fragmented underwriting into confident lending decisions."
        },

        "steps": [
          {
            "icon": "flow",
            "title": "Standardize credit ratio definitions",
            "body": "Collaborated with senior risk officers to unify cash flow, coverage ratio, and leverage definitions across all commercial lending divisions.",
            "weight": 24,
            "points": [
              "Unified cash flow definitions",
              "Aligned coverage and leverage rules",
              "Documented policy assumptions"
            ]
          },
          {
            "icon": "grid",
            "title": "Construct automated data extraction tools",
            "body": "Built parsing utilities to automatically ingest borrower financial statements, tax filings, and bank statements directly into unified data models.",
            "weight": 28,
            "points": [
              "Statement and filing ingestion",
              "Normalized borrower data models",
              "Reduced manual re-keying"
            ]
          },
          {
            "icon": "code",
            "title": "Deploy Python risk-scoring algorithms",
            "body": "Programmed multi-factor credit risk scoring engines incorporating industry benchmarks, debt service coverage, and macroeconomic sensitivity.",
            "weight": 28,
            "points": [
              "Multi-factor risk scoring",
              "Industry benchmark checks",
              "Macroeconomic sensitivity tests"
            ]
          },
          {
            "icon": "shield",
            "title": "Establish audit logs & compliance checks",
            "body": "Integrated automated audit trails and rule validation to ensure full compliance with internal credit policies and regulatory standards.",
            "weight": 20,
            "points": [
